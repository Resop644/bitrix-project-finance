PORT=3000
DB_FILE=./data/finance.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Bitrix24 OAuth application credentials
BITRIX_CLIENT_ID=your_client_id
BITRIX_CLIENT_SECRET=your_client_secret
# Long random secret used to encrypt Bitrix access/refresh tokens at rest.
BITRIX_ENCRYPTION_KEY=replace-with-a-long-random-secret
